FROM python:3.14-slim

WORKDIR /app

# R runtime (for trigger_update.R) + system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    libcurl4-openssl-dev \
    libssl-dev \
    libpq-dev \
    libzstd-dev \
    liblz4-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies (above source so a code edit doesn't invalidate this layer)
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
ENV PATH="/app/.venv/bin:${PATH}"

# R packages needed by trigger_update.R (same caching motivation)
RUN R -e "install.packages(c('DBI', 'RPostgres', 'data.table', 'qs2', 'jsonlite'))"

# Pipeline source code
COPY pipeline/ pipeline/
# Only the R files trigger_update.R sources — keeps the layer stable when
# Shiny-only files (ui.R, server*.R, tooltips.R, etc.) change.
COPY R/env.R R/constants.R R/utils.R R/clean_table1.R R/clean_table2.R R/read_external_data.R R/
COPY scripts/ scripts/
COPY sql/ sql/

# uid 997 matches the shiny user in the dashboard image so both containers
# can share the qs_data volume without a chown init step.
RUN groupadd --system --gid 997 shiny && useradd --system --uid 997 --gid 997 shiny
USER 997
